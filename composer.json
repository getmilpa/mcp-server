{
  "name": "milpa/mcp-server",
  "description": "Model Context Protocol (MCP) transport core for the Milpa PHP framework: a transport-agnostic JSON-RPC 2.0 dispatcher over the tool-runtime registry, plus the auth seam a host implements to turn a bearer token into an authenticated caller.",
  "keywords": [
    "php",
    "milpa",
    "framework",
    "mcp",
    "model-context-protocol",
    "json-rpc",
    "server",
    "ai"
  ],
  "type": "milpa-capability",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Rodrigo Vicente - TeamX Agency",
      "homepage": "https://x.com/rodrigoteamx"
    }
  ],
  "require": {
    "php": ">=8.3",
    "milpa/core": "^0.6.2 || ^0.7",
    "milpa/tool-runtime": "^0.9 || ^0.10",
    "psr/log": "^3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpdoc-parser": "^2.3",
    "friendsofphp/php-cs-fixer": "^3.65"
  },
  "autoload": {
    "psr-4": {
      "Milpa\\McpServer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Milpa\\McpServer\\Tests\\": "tests/",
      "Milpa\\Docs\\": "vendor/milpa/core/tools/gen-docs/"
    }
  },
  "extra": {
    "milpa": {
      "capability": {
        "id": "mcp",
        "title": "The same operations, exposed to an external MCP client",
        "unlocks": [
          "bin/mcp-server.php"
        ],
        "provides": [
          "surface.mcp"
        ],
        "briefing": "The operations of this app are also served over MCP.",
        "contracts": {
          "surface.mcp": "Milpa\\McpServer\\JsonRpcService"
        }
      }
    }
  }
}
